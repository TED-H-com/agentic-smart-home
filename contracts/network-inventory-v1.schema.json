{
  "$defs": {
    "InventoryObservation": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "anyOf": [
            {
              "maxLength": 45,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address"
        },
        "id": {
          "pattern": "^[a-zA-Z0-9_-]{1,128}$",
          "title": "Id",
          "type": "string"
        },
        "mac": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{2}(:[0-9a-f]{2}){5}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mac"
        },
        "metadata": {
          "additionalProperties": {
            "maxLength": 160,
            "type": "string"
          },
          "maxProperties": 8,
          "propertyNames": {
            "maxLength": 32
          },
          "title": "Metadata",
          "type": "object"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "observed_at": {
          "maxLength": 160,
          "title": "Observed At",
          "type": "string"
        },
        "reachability": {
          "default": "unknown",
          "enum": [
            "unknown",
            "responded"
          ],
          "title": "Reachability",
          "type": "string"
        },
        "scope_id": {
          "pattern": "^[a-zA-Z0-9_-]{1,128}$",
          "title": "Scope Id",
          "type": "string"
        },
        "services": {
          "default": [],
          "items": {
            "maxLength": 160,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Services",
          "type": "array"
        },
        "source_id": {
          "enum": [
            "lan_neighbors",
            "lan_mdns",
            "lan_ssdp",
            "router_import"
          ],
          "title": "Source Id",
          "type": "string"
        },
        "source_updated_at": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Updated At"
        }
      },
      "required": [
        "id",
        "source_id",
        "scope_id",
        "observed_at"
      ],
      "title": "InventoryObservation",
      "type": "object"
    },
    "InventoryRecommendation": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "enum": [
            "service_match",
            "hint"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "documentation_url": {
          "pattern": "^https://www\\.home-assistant\\.io/integrations/[a-z0-9_]+/$",
          "title": "Documentation Url",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-zA-Z0-9_-]{1,128}$",
          "title": "Id",
          "type": "string"
        },
        "integration_domain": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Integration Domain",
          "type": "string"
        },
        "native_path": {
          "const": "/config/integrations",
          "default": "/config/integrations",
          "title": "Native Path",
          "type": "string"
        },
        "next_step": {
          "maxLength": 160,
          "title": "Next Step",
          "type": "string"
        },
        "observation_id": {
          "pattern": "^[a-zA-Z0-9_-]{1,128}$",
          "title": "Observation Id",
          "type": "string"
        },
        "reason": {
          "maxLength": 160,
          "title": "Reason",
          "type": "string"
        },
        "title": {
          "maxLength": 160,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "observation_id",
        "integration_domain",
        "title",
        "confidence",
        "reason",
        "next_step",
        "documentation_url"
      ],
      "title": "InventoryRecommendation",
      "type": "object"
    },
    "InventorySource": {
      "additionalProperties": false,
      "properties": {
        "adapter_version": {
          "const": 1,
          "default": 1,
          "title": "Adapter Version",
          "type": "integer"
        },
        "content_digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Digest"
        },
        "id": {
          "enum": [
            "lan_neighbors",
            "lan_mdns",
            "lan_ssdp",
            "router_import"
          ],
          "title": "Id",
          "type": "string"
        },
        "item_count": {
          "anyOf": [
            {
              "maximum": 1024,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Count"
        },
        "limitations": {
          "default": [],
          "items": {
            "maxLength": 160,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Limitations",
          "type": "array"
        },
        "method": {
          "enum": [
            "neighbor_table",
            "mdns",
            "ssdp",
            "json_import",
            "csv_import",
            "dnsmasq_import"
          ],
          "title": "Method",
          "type": "string"
        },
        "observed_at": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At"
        },
        "reason_code": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        },
        "state": {
          "enum": [
            "ok",
            "partial",
            "unavailable",
            "not_configured",
            "expired"
          ],
          "title": "State",
          "type": "string"
        },
        "target": {
          "maxLength": 160,
          "title": "Target",
          "type": "string"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "state",
        "method",
        "target"
      ],
      "title": "InventorySource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "content_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Digest",
      "type": "string"
    },
    "contract_version": {
      "const": 1,
      "default": 1,
      "title": "Contract Version",
      "type": "integer"
    },
    "expires_at": {
      "anyOf": [
        {
          "maxLength": 160,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    },
    "limitations": {
      "items": {
        "maxLength": 160,
        "type": "string"
      },
      "maxItems": 16,
      "title": "Limitations",
      "type": "array"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/InventoryObservation"
      },
      "maxItems": 1024,
      "title": "Observations",
      "type": "array"
    },
    "observed_at": {
      "maxLength": 160,
      "title": "Observed At",
      "type": "string"
    },
    "recommendations": {
      "items": {
        "$ref": "#/$defs/InventoryRecommendation"
      },
      "maxItems": 1024,
      "title": "Recommendations",
      "type": "array"
    },
    "revision": {
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/InventorySource"
      },
      "maxItems": 4,
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "revision",
    "observed_at",
    "sources",
    "observations",
    "recommendations",
    "limitations",
    "content_digest"
  ],
  "title": "InventorySnapshot",
  "type": "object"
}

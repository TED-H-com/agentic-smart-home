{
  "$defs": {
    "InventoryObservation": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "anyOf": [
            {
              "maxLength": 45,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address"
        },
        "id": {
          "pattern": "^[a-zA-Z0-9_-]{1,128}$",
          "title": "Id",
          "type": "string"
        },
        "mac": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{2}(:[0-9a-f]{2}){5}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mac"
        },
        "metadata": {
          "additionalProperties": {
            "maxLength": 160,
            "type": "string"
          },
          "maxProperties": 8,
          "propertyNames": {
            "maxLength": 32
          },
          "title": "Metadata",
          "type": "object"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "observed_at": {
          "maxLength": 160,
          "title": "Observed At",
          "type": "string"
        },
        "reachability": {
          "default": "unknown",
          "enum": [
            "unknown",
            "responded"
          ],
          "title": "Reachability",
          "type": "string"
        },
        "scope_id": {
          "pattern": "^[a-zA-Z0-9_-]{1,128}$",
          "title": "Scope Id",
          "type": "string"
        },
        "services": {
          "default": [],
          "items": {
            "maxLength": 160,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Services",
          "type": "array"
        },
        "source_id": {
          "enum": [
            "lan_neighbors",
            "lan_mdns",
            "lan_ssdp",
            "router_import"
          ],
          "title": "Source Id",
          "type": "string"
        },
        "source_updated_at": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Updated At"
        }
      },
      "required": [
        "id",
        "source_id",
        "scope_id",
        "observed_at"
      ],
      "title": "InventoryObservation",
      "type": "object"
    },
    "InventorySource": {
      "additionalProperties": false,
      "properties": {
        "adapter_version": {
          "const": 1,
          "default": 1,
          "title": "Adapter Version",
          "type": "integer"
        },
        "content_digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Digest"
        },
        "id": {
          "enum": [
            "lan_neighbors",
            "lan_mdns",
            "lan_ssdp",
            "router_import"
          ],
          "title": "Id",
          "type": "string"
        },
        "item_count": {
          "anyOf": [
            {
              "maximum": 1024,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Count"
        },
        "limitations": {
          "default": [],
          "items": {
            "maxLength": 160,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Limitations",
          "type": "array"
        },
        "method": {
          "enum": [
            "neighbor_table",
            "mdns",
            "ssdp",
            "json_import",
            "csv_import",
            "dnsmasq_import"
          ],
          "title": "Method",
          "type": "string"
        },
        "observed_at": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At"
        },
        "reason_code": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        },
        "state": {
          "enum": [
            "ok",
            "partial",
            "unavailable",
            "not_configured",
            "expired"
          ],
          "title": "State",
          "type": "string"
        },
        "target": {
          "maxLength": 160,
          "title": "Target",
          "type": "string"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "state",
        "method",
        "target"
      ],
      "title": "InventorySource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Fixed Host broker output; contains projected observations, never credentials.",
  "properties": {
    "contract_version": {
      "const": 1,
      "default": 1,
      "title": "Contract Version",
      "type": "integer"
    },
    "limitations": {
      "items": {
        "maxLength": 160,
        "type": "string"
      },
      "maxItems": 16,
      "title": "Limitations",
      "type": "array"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/InventoryObservation"
      },
      "maxItems": 768,
      "title": "Observations",
      "type": "array"
    },
    "observed_at": {
      "maxLength": 160,
      "title": "Observed At",
      "type": "string"
    },
    "scope_id": {
      "pattern": "^[a-zA-Z0-9_-]{1,128}$",
      "title": "Scope Id",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/InventorySource"
      },
      "maxItems": 3,
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "scope_id",
    "observed_at",
    "sources",
    "observations",
    "limitations"
  ],
  "title": "InventoryCollection",
  "type": "object"
}

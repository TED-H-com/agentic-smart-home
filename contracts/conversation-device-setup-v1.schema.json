  "additionalProperties": false,
  "description": "One current-message setup selection; history is not current HA health.",
  "properties": {
    "available_entity_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }

            "2sa",
            "backup_share"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Step"
    },
    "integration": {
      "anyOf": [
        {
          "$ref": "#/$defs/DiscoveryIntegration"
        },
        {
          "type": "null"
        }
      ],
      "default": null

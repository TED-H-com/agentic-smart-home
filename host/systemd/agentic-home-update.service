[Unit]
Description=Agentic Home approved Host bundle update
After=docker.service libvirtd.service
Requires=docker.service libvirtd.service
ConditionPathExists=/usr/lib/agentic-home-update/current/agentic_host/host_update.py

[Service]
Type=oneshot
Environment=PYTHONPATH=/usr/lib/agentic-home-update/current
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m agentic_host.host_update --execute
TimeoutStartSec=3600
UMask=0077
ProtectHome=true
NoNewPrivileges=true
